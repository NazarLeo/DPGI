<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <!-- Притискаємо мітку до верху -->
        <Label Content="Label" 
           DockPanel.Dock="Top" 
           HorizontalAlignment="Center" 
           Margin="10"/>

        <!-- Притискаємо кнопку до низу -->
        <Button Content="Button" 
            DockPanel.Dock="Bottom" 
            Width="80" 
            Height="30" 
            Margin="0,20,0,40"/>

        <!-- Лівий TextBox притискаємо до лівого краю -->
        <TextBox Text="TextBox" 
             DockPanel.Dock="Left" 
             Width="250" 
             Margin="10,0,10,0"/>

        <!-- Правий TextBox притискаємо до правого краю -->
        <TextBox Text="TextBox" 
             DockPanel.Dock="Right" 
             Width="250" 
             Margin="10,0,10,0"/>

        <!-- Центральна частина залишиться порожньою завдяки LastChildFill, 
         якщо сюди нічого не додавати, або можна додати порожній контейнер -->
    </DockPanel>
</Window>
