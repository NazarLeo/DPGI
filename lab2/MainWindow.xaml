<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">

    <Canvas Background="Cyan">
        <!-- Label: зміщення 20 одиниць (Left: 20, Top: 20) -->
        <Label Content="Label" 
               Canvas.Left="20" 
               Canvas.Top="20"/>

        <!-- TextBox: зміщення 40 одиниць (Left: 40, Top: 40) -->
        <TextBox Text="text" 
                 Width="50"
                 Canvas.Left="40" 
                 Canvas.Top="40"/>

        <!-- Button: зміщення 60 одиниць (Left: 60, Top: 60) -->
        <Button Content="button" 
                Canvas.Left="60" 
                Canvas.Top="60"/>
    </Canvas>
</Window>