<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <!-- Перший ряд у 4 рази менший за другий -->
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
            <!-- Третій ряд визначається автоматично -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Label у першому рядку, другий стовпець -->
        <Label Content="Label" Grid.Row="0" Grid.Column="1"/>

        <!-- TextBox на весь другий рядок (ColumnSpan="3") -->
        <TextBox Text="TextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"/>

        <!-- Button у третьому рядку, другий стовпець -->
        <Button Content="Button" Grid.Row="2" Grid.Column="1"/>
    </Grid>
</Window>
