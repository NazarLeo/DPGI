<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="550">
        <!-- Перший ряд: Label + 8 TextBox -->
        <Label Content="Label" VerticalAlignment="Center" Margin="5,0"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>

        <!-- Другий ряд: Label + 8 TextBox -->
        <Label Content="Label" VerticalAlignment="Center" Margin="5,0"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>
        <TextBox Text="TextBox" Width="55" Margin="1"/>

        <!-- Кнопка знизу (вирівняна за допомогою великого Margin для імітації центру) -->
        <Button Content="Button" Width="80" Margin="235,15,0,0"/>
    </WrapPanel>
</Window>
