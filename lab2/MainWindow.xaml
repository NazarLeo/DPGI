<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextEditor" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Автоматична висота для панелі інструментів -->
            <RowDefinition Height="Auto"/>
            <!-- Решта простору для текстової області -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Рамка із закругленими кутами у першому рядку -->
        <Border Grid.Row="0" 
                BorderBrush="#FFCBBEBE" 
                BorderThickness="2" 
                CornerRadius="10" 
                Margin="5">

            <!-- Горизонтальна панель для кнопок -->
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Відкрити" Margin="2">
                    <Image Source="images/open.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Стерти" Margin="2">
                    <Image Source="images/clear.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Копіювати" Margin="2">
                    <Image Source="images/copy.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Вставити" Margin="2">
                    <Image Source="images/paste.png" Height="40" Width="40"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Текстова область у другому рядку -->
        <TextBox Grid.Row="1" Margin="5" AcceptsReturn="True" TextWrapping="Wrap"/>
    </Grid>
</Window>