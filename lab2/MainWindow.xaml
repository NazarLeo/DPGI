<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="50,0">
        <!-- Центруємо текст мітки -->
        <Label Content="Label" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Створюємо 4 текстових поля, як на скриншоті -->
        <TextBox Text="TextBox" Margin="0,2"/>
        <TextBox Text="TextBox" Margin="0,2"/>
        <TextBox Text="TextBox" Margin="0,2"/>
        <TextBox Text="TextBox" Margin="0,2"/>

        <!-- Кнопка з обмеженою шириною та великим відступом зверху -->
        <Button Content="Button" 
            Width="150" 
            HorizontalAlignment="Center" 
            Margin="0,40,0,0"/>
    </StackPanel>
</Window>
