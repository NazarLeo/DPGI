<Window x:Class="lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextEditor" Height="450" Width="800">

    <Window.Resources>
        <!-- Ресурс градієнтної заливки жовто-блакитно-жовтої -->
        <LinearGradientBrush x:Key="LinearPanelBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="Yellow" Offset="0.0" />
            <GradientStop Color="Cyan" Offset="0.5" />
            <GradientStop Color="Yellow" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Стиль для кнопок панелі інструментів -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель інструментів із використанням градієнта -->
        <Border Grid.Row="0" 
                BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5"
                Background="{StaticResource LinearPanelBrush}">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Відкрити">
                    <Image Source="images/open.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Стерти">
                    <Image Source="images/clear.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Копіювати">
                    <Image Source="images/copy.png" Height="40" Width="40"/>
                </Button>
                <Button ToolTip="Вставити">
                    <Image Source="images/paste.png" Height="40" Width="40"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Оточення текстового поля із використанням градієнта -->
        <Border Grid.Row="1" 
                BorderBrush="#FFCBBEBE" BorderThickness="2" CornerRadius="10" Margin="5"
                Background="{StaticResource LinearPanelBrush}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"
                         Background="White"/>

                <DockPanel Grid.Row="1" LastChildFill="False">
                    <!-- Скасування стилю для кнопки OK (Style={x:Null}) -->
                    <Button Content="OK" 
                            Style="{x:Null}"
                            DockPanel.Dock="Bottom" 
                            HorizontalAlignment="Center" 
                            Padding="10,2" 
                            Margin="0,10,0,0"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>